<!doctype html>
<html
  lang="en"
  class="is-booting"
  aria-busy="true"
  data-color-mode="<%= colorMode %>"
  data-light-theme="light"
  data-dark-theme="dark"
  data-view="<%= view %>"
  data-diff="<%= diffMode %>"
  data-branch="<%= head %>"
  data-base="<%= base %>"
  data-repo="<%= repoPath %>"
  data-comments-enabled="<%= commentsEnabled ? '1' : '0' %>"
>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= repoName %> — PR Review</title>
  <!-- GitHub's exact design tokens; both files loaded so auto mode follows the OS -->
  <link rel="stylesheet" href="/vendor/primer/functional/themes/light.css" />
  <link rel="stylesheet" href="/vendor/primer/functional/themes/dark.css" />
  <link rel="stylesheet" href="/static/css/diff.css" />
</head>
<body>
  <div id="page-progress" class="page-progress is-active" role="progressbar" aria-label="Loading"></div>
  <header class="pr-subnav">
    <div class="pr-subnav-inner">
      <div class="pr-title-row">
        <button class="tree-pane-toggle" title="Toggle file tree" aria-label="Toggle file tree" hidden>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v12.5A1.75 1.75 0 0 1 14.25 16H1.75A1.75 1.75 0 0 1 0 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25H5V1.5Zm4.75 0v13h7.75a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25Z"></path></svg>
        </button>
        <h1 class="pr-title">Files changed</h1>
        <span class="pr-refs">
          <% if (diffMode === 'working') { %>
          <span class="ref-static">
            <span class="ref-pill">working tree</span>
          </span>
          <span class="ref-arrow">into</span>
          <% if (isRepo) { %>
          <%- include('ref-picker', { param: 'head', selected: head, label: 'Compare against branch', fetchedLabel: headFetchedLabel, fetchedTitle: headFetchedTitle, branches }) %>
          <% } else { %>
          <span class="ref-static">
            <span class="ref-pill"><%= head %></span>
          </span>
          <% } %>
          <% } else { %>
          <% if (isRepo) { %>
          <%- include('ref-picker', { param: 'head', selected: head, label: 'Current branch', fetchedLabel: headFetchedLabel, fetchedTitle: headFetchedTitle, branches }) %>
          <span class="ref-arrow">into</span>
          <%- include('ref-picker', { param: 'base', selected: base, label: 'Target branch', fetchedLabel: baseFetchedLabel, fetchedTitle: baseFetchedTitle, branches }) %>
          <% } else { %>
          <span class="ref-pill"><%= head %></span>
          <span class="ref-arrow">into</span>
          <span class="ref-pill"><%= base %></span>
          <% } %>
          <% } %>
        </span>
        <% if (isRepo && checkedOut && head && head !== checkedOut) { %>
        <span class="ref-note">comparing <code><%= head %></code> (not checked out)</span>
        <% } %>
      </div>
      <div class="pr-meta-row">
        <span class="pr-meta-left">
          <span class="diff-summary" data-boot-summary>
            <span class="inline-loading">Loading…</span>
          </span>
          <% if (commentsEnabled) { %>
          <span id="comments-loading" class="inline-loading" hidden>Loading comments…</span>
          <% } %>
        </span>
        <span class="pr-meta-right">
          <% if (commentsEnabled && isRepo) { %>
          <button id="import-pr-btn" class="import-pr-btn" title="Fetch this branch's GitHub PR review comments">Import PR comments</button>
          <% } %>
          <% if (commentsEnabled) { %>
          <button id="export-btn" class="export-btn" hidden>Export for Claude</button>
          <button id="clear-btn" class="clear-btn" hidden>Clear</button>
          <% } %>
          <% if (isRepo) { %>
          <span class="seg-toggle" role="group" aria-label="Changes to show">
            <a class="seg-btn<%= diffMode === 'all' ? ' is-active' : '' %>"
               href="?diff=all" data-param="diff" data-value="all" title="Branch commits + uncommitted + untracked">All</a>
            <a class="seg-btn<%= diffMode === 'branch' ? ' is-active' : '' %>"
               href="?diff=branch" data-param="diff" data-value="branch" title="Committed changes on this branch vs base">Branch</a>
            <a class="seg-btn<%= diffMode === 'working' ? ' is-active' : '' %>"
               href="?diff=working" data-param="diff" data-value="working" title="Uncommitted + untracked changes">Working</a>
          </span>
          <% } %>
          <span class="seg-toggle view-toggle" role="group" aria-label="Diff view">
            <a class="seg-btn<%= view === 'unified' ? ' is-active' : '' %>"
               href="?view=unified" data-param="view" data-value="unified">Unified</a>
            <a class="seg-btn<%= view === 'split' ? ' is-active' : '' %>"
               href="?view=split" data-param="view" data-value="split">Split</a>
          </span>
          <span class="repo-picker">
            <button type="button" class="repo-path" title="Click to change project path"><%= repoPath %></button>
            <button type="button" class="repo-shortcuts-toggle" aria-haspopup="menu" aria-expanded="false" title="Saved projects" aria-label="Saved projects">
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4.427 7.427 7.896 10.9a.25.25 0 0 0 .354 0l3.469-3.473A.25.25 0 0 0 11.542 7H4.604a.25.25 0 0 0-.177.427Z"></path></svg>
            </button>
            <div class="repo-shortcuts-menu" role="menu" hidden></div>
          </span>
        </span>
      </div>
    </div>
  </header>
  <div id="boot-panel" class="boot-panel" role="status" aria-live="polite">
    <div class="spinner" aria-hidden="true"></div>
    <p class="boot-copy">Preparing diff…</p>
  </div>
